<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portifólio</title>
</head>
    <link rel="stylesheet" href="style.css"
<body>

    <div class="particulas"></div>

    <nav class="navegacao">
        <ul class="menu">
            <li>
                <a href="#inicio" class="menu-link">inicio</a> 
            </li>
            <li>
                <a href="#sobre" class="menu-link">sobre</a>
            </li>
            <li>
                <a href="#projeto" class="menu-link">projeto</a>
            </li>
            <li>
                <a href="#contato" class="menu-link">contato</a>
            </li>
        </ul>
    </nav>
    
    <main id="inicio" class="cabecalho">
            <img src ="./img/image.png" alt="foto de perfil" class="foto-perfil">
            <h1>Pedro Henrique</h1>
            <p class="cabecalho-sub-titulo" Desenvolvedor fullstack</p>
    </main>

    <section id="sobre" class="sobre" >
        <h2 class="sobre-titulo">Sobre mim</h2>
        <div class="sobre-caixa">
            <p class="sobre-paragrafo">
                Desenvolvedor fullstack apaixonado por tecnologia e inovação. Com experiência em python, CSS, JavaScript e frameworks modernos, busco criar soluções web eficientes e intuitivas.
            </p>
        </div>
    </section>

    <section id="projeto" class="projeto">
        <h2 class="projeto-titulo">Meus Projetos</h2>
        <div class="projeto-caixa">

        <div class="projeto-card">
            <img src="./img/xbox print site.png" alt="Projeto 1" class="projeto-imagem">
            <div class="caixa-texto-projeto">
                <h3 class="info-projeto">Xbox: Onde os jogos ganham vida</h3>
                <p class="paragrafo-projeto">Uma loja online de jogos eletrônicos com design moderno e funcionalidade completa.</p>
            </div>
        </div>

        <div class="projeto-card">
            <img src="./img/airbnb site.png" alt="Projeto 1" class="projeto-imagem">
            <div class="caixa-texto-projeto">
                <h3 class="info-projeto">Airbnb — Hospedagens e experiências inesquecíveis</h3>
                <p class="paragrafo-projeto">Pagina de viajens destinada para pessoas que pensam grande.</p>
            </div>
        </div>

        <div class="projeto-card">
            <img src="./img/microsoft print site.png" alt="Projeto 1" class="projeto-imagem">
            <div class="caixa-texto-projeto">
                <h3 class="info-projeto">Microsoft: Tecnologia que impulsiona pessoas e empresas</h3>
                <p class="paragrafo-projeto">A Microsoft é uma empresa global de tecnologia que desenvolve softwares e soluções digitais.</p>
            </div>
        </div>

        </div>
    </section>

    <section id="contato" class="contato">
        <h2 class="contato-titulo">Entre em Contato</h2>
        
        <form class="formulario-contato" id="formulario" onsubmit="enviarWhats(event)"> 
            <div class="grupo-form">
                <input  placeholder="nome" class="campo-form" id="nome">  
            </div>

            <div class="grupo-form">
                <textarea class="campo-form" placeholder="Digite sua Mensagem" id ="mensagem"></textarea>
            </div>

            <button type="submit" class="botao-form">Enviar Whatsapp</button>
        </form>

    </section>

    <script>
        function enviarWhats(event) {
            
            const nome = document.getElementById('nome').value;
            const mensagem = document.getElementById('mensagem');
            const telefone = '554796016322'

            const texto = `Olá! Me chamo ${nome}, ${mensagem}`
            const msgformatada = encodeURIComponent (texto)

            const url= `https://wa.me/${telefone}?text=${msgformatada}`

            console.log(url)


            window.open(url, '_blank')

        }

    </script>
</body>

</html>
